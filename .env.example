DATABASE_URL=postgresql://vybe:vybe@localhost:5433/vybe?schema=public
TEST_DATABASE_URL=postgresql://vybe:vybe@localhost:5433/vybe_test?schema=public
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d
PORT=3001
HOST=0.0.0.0
# Allowed CORS origins. In production set the deployed web URL(s), comma-separated
# (e.g. https://vybe.vercel.app,https://vybe-git-main.vercel.app) or * for any.
WEB_URL=http://localhost:5173
UPLOAD_DIR=./uploads
# Full-audio enrichment tuning. FULL_AUDIO_LIMIT=0 (default) disables the
# per-track archive lookups (they hammer archive.org and rarely match).
# Set a small number (e.g. 5) to re-enable for a handful of tracks per request.
FULL_AUDIO_LIMIT=0
FULL_AUDIO_BUDGET_MS=12000
